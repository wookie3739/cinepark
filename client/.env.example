# 브라우저에서 직접 호출할 Cinepark API (Spring 기본 http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth (Auth.js v5) — 배포 시 필수. 로컬은 auth.ts에 개발용 fallback이 있으나 운영에서는 반드시 설정하세요.
# openssl rand -base64 32
AUTH_SECRET=

# 선택: 배포 URL (미설정 시 trustHost로 추론)
# AUTH_URL=https://your-domain.example
